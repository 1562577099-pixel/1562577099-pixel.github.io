{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"apgUtREAACsA3cp7","uid":"seniordigitaldesigner","url":null,"type":"job_role","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22apgUtREAACsA3cp7%22%29+%5D%5D","tags":[],"first_publication_date":"2026-09-02T12:25:13+0000","last_publication_date":"2026-09-02T12:25:13+0000","slugs":["the-role"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"job_title":"Senior Digital Designer","job_tagline":"King of the Rectangles","job_mini_description":[],"tags":"Full Time, Remote","application_email":{"link_type":"Any"},"image":{},"introduction":[{"type":"paragraph","text":"Come join the team at ToyFight. We're a team of strategists, designers, developers and technologists with a passion for creating digital experiences for consumers and brands.","spans":[],"direction":"ltr"}],"slices":[{"variation":"default","version":"initial","items":[],"primary":{"heading":"Roles & Responsibilities","content":[{"type":"heading4","text":"The Role","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We’re looking for a talented Senior Digital Designer to join our team.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You’ll work across a broad range of projects, from websites and interactive experiences to digital products and campaigns. Working closely with our Creative Directors, developers and wider creative team, you’ll help shape ideas and turn them into considered, beautifully crafted digital experiences.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You’ll be comfortable taking ownership of projects from initial concepts and exploration through to detailed design and final delivery.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You'll Do","spans":[],"direction":"ltr"},{"type":"list-item","text":"Create thoughtful, original and beautifully crafted digital experiences.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Take ownership of design across projects, from initial concepts through to final delivery.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Work closely with our team to develop and refine creative ideas.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Collaborate with developers throughout the design and build process.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Present work clearly and confidently to both the team and clients.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Consider interaction, motion and behaviour as an integral part of the design process.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Contribute to maintaining and developing the studio’s design standards.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Stay informed about new tools, technologies and developments within digital design.","spans":[],"direction":"ltr"},{"type":"list-item","text":"The confidence to take ownership of your work while being open to collaboration, feedback and direction.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Strong communication skills and the ability to clearly articulate the thinking behind your work.","spans":[],"direction":"ltr"},{"type":"list-item","text":"An enthusiasm for digital design and a genuine interest in continuing to develop your craft.","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You’ll Bring","spans":[],"direction":"ltr"},{"type":"list-item","text":"Around 4+ years of digital design experience, ideally within an agency or studio environment.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A strong portfolio demonstrating excellent digital design, ideas and craft.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Excellent visual design, typography and layout skills.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A strong understanding of UX, interaction and responsive design.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A high level of attention to detail and a strong eye for what makes great design.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Excellent knowledge of Figma and contemporary digital design processes.","spans":[],"direction":"ltr"},{"type":"list-item","text":"An understanding of motion, 3D, WebGL or creative development would be a plus. You don’t need to build these experiences yourself, but an understanding of their possibilities is important.","spans":[],"direction":"ltr"},{"type":"heading4","text":"Why Join Us","spans":[],"direction":"ltr"},{"type":"list-item","text":"Work on ambitious digital projects for a broad range of interesting brands.","spans":[],"direction":"ltr"},{"type":"list-item","text":"The opportunity to experiment with new technologies, tools and approaches.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Work alongside an experienced team with a strong focus on ideas and craft.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Opportunities for training, conferences and continued professional development.","spans":[],"direction":"ltr"},{"type":"list-item","text":"The tools and equipment you need to do your best work.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A culture built around collaboration, curiosity and high standards.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Competitive salary and benefits.","spans":[],"direction":"ltr"},{"type":"list-item","text":"4 Day Week 100:80:100","spans":[],"direction":"ltr"}]},"id":"job_content$d41ccd7c-9b6e-4a96-a961-ecac734ea2bb","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Location","content":[{"type":"heading4","text":"Location","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Wherever you want.","spans":[],"direction":"ltr"}]},"id":"job_content$3e676e56-630f-432c-ba4e-4bc57d7f4893","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Salary","content":[{"type":"heading4","text":"Salary","spans":[],"direction":"ltr"},{"type":"paragraph","text":"£DOE","spans":[],"direction":"ltr"}]},"id":"job_content$5d6af2d9-7106-4028-afa3-ff8c410855cf","slice_type":"job_content","slice_label":null}],"meta_description":"Digital Designer - Come join the team at ToyFight. We're a team of strategists, designers, developers and technologists with a passion for creating digital experiences for consumers and brands.","meta_image":{},"meta_title":"Digital Designer Role at ToyFight"}}],"version":"9eb0c14","license":"All Rights Reserved"}