{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"ZT9siREAACIAcjin","uid":"cult-gaia","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZT9siREAACIAcjin%22%29+%5D%5D","tags":[],"first_publication_date":"2023-10-30T08:42:53+0000","last_publication_date":"2024-05-21T12:17:49+0000","slugs":["cult-gaia"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Cult Gaia","popout_text":null,"strapline":"The Art of Making a Statement","description":[{"type":"paragraph","text":"Cult Gaia, known for its unique, must-have products, needed an eCommerce experience that captured its essence. We embraced the brand's admiration for the female form with graphical elements and typography reflecting product influences.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Our design pushed Shopify to its limits, creating an immersive, visually stunning online store. We curated a layout that highlighted the elegance of the products and used visual elements to reflect the brand's distinctive aesthetic, delivering a shopping experience worthy of Cult Gaia's lifestyle-enhancing offerings.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":212,"height":120},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/ZjzFYkMTzAJOCqYB_cg-thumb.jpg?auto=format,compress","id":"ZjzFYkMTzAJOCqYB","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":"https://res.cloudinary.com/durdzswls/video/upload/f_auto:video,q_auto/v1/case-studies/cult-gaia/cg-work-thumb","thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":212,"thumbnail_video_height":120,"background_color":"#1C1C1E","hero_image":{"dimensions":{"width":2968,"height":2128},"alt":"Cult Gaia","copyright":null,"url":"https://images.prismic.io/toyfigh