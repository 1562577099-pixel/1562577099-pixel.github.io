{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"ZjKcLREAANkeVtbn","uid":"twitch","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZjKcLREAANkeVtbn%22%29+%5D%5D","tags":[],"first_publication_date":"2024-05-01T20:00:38+0000","last_publication_date":"2024-05-14T12:08:54+0000","slugs":[],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Twitch","popout_text":null,"strapline":"Entertainment Your Way","description":[{"type":"paragraph","text":"Twitch embarked on an exciting rebrand and sought to amplify it across their website’s marketing pages. Partnering with Instrument, we swiftly iterated concepts to weave the new visual identity into site designs, using type, colour, copy, and motion to bring the branding to life in the most captivating way.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Our team harnessed the dynamic energy of the rebrand by incorporating fluid, engaging motion that added an extra layer of vibrancy to the digital experience. Each design element was meticulously crafted to resonate with Twitch's bold identity, ensuring every page reflected the platform’s creative spirit while engaging users in a truly compelling journey.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":152,"height":152},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/ZjzEjEMTzAJOCqXd_twitch-thumb.jpg?auto=format,compress","id":"ZjzEjEMTzAJOCqXd","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":"https://res.cloudinary.com/durdzswls/video/upload/f_auto:video,q_auto/v1/case-studies/twitch/twitch2-work-thumb","thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":156,"thumbnail_video_height":156,"background_color":null,"hero_image":{"dimensions":{"width":2968,"h