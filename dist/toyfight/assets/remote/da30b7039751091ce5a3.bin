{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"ZjDQABEAAGUZXKdn","uid":"under-armour","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZjDQABEAAGUZXKdn%22%29+%5D%5D","tags":[],"first_publication_date":"2024-04-30T11:15:37+0000","last_publication_date":"2024-05-14T12:32:49+0000","slugs":[],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Under Armour","popout_text":null,"strapline":"Makes You Better","description":[{"type":"paragraph","text":"Under Armour needed a unified design system to align its global eCommerce properties. Working alongside long-time partners BASIC agency, we led the conceptualisation and crafted a system to guide the continued evolution of the UA digital experience while shaping the design of underarmour.com","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We shaped the strategy with BASIC, working through the core concepts to establish a cohesive visual identity and user journey. Our team provided key page templates and UX designs that embodied the brand’s values, resulting in an engaging, seamless eCommerce presence that drives the next chapter of Under Armour’s digital story.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":160,"height":212},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/ZjzE5kMTzAJOCqXv_ua-thumb.jpg?auto=format,compress","id":"ZjzE5kMTzAJOCqXv","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":"https://res.cloudinary.com/durdzswls/video/upload/f_auto:video,q_auto/v1/case-studies/under-armour/ua-work-thumb","thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":160,"thumbnail_video_height":212,"background_color":null,"hero_image":{"dimensions":{"width":2968,"height":2128},"alt":"Woman wearing UA Jump