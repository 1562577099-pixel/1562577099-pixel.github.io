{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"Z1gmmhIAACIAVSXo","uid":"gsap-lovie-wins","url":null,"type":"news","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Z1gmmhIAACIAVSXo%22%29+%5D%5D","tags":[],"first_publication_date":"2024-12-10T11:36:10+0000","last_publication_date":"2024-12-10T12:08:58+0000","slugs":["gsap-wins-gold-lovie--peoples-choice-award"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"GSAP Wins Gold Lovie + People's Choice Award","heading_colours":[{"word_index":0,"word_colour":"#FFF490"},{"word_index":2,"word_colour":"#E9E3F3"}],"banner_image":{"dimensions":{"width":2592,"height":1600},"alt":"Lovie Award Winner","copyright":null,"url":"https://images.prismic.io/toyfight/Z1gnDpbqstJ98QYh_lovie-award-hero.jpg?auto=format,compress","id":"Z1gnDpbqstJ98QYh","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"banner_video_url":null,"date_string":"November 2024","thumbnail":{},"thumbnail_video":null,"related_news":{"id":"Zfl_KxIAAPSMwt63","type":"news","tags":[],"lang":"en-gb","slug":"-","first_publication_date":"2024-03-19T12:06:09+0000","last_publication_date":"2024-05-13T12:18:52+0000","uid":"building-gsap-asap","link_type":"Document","key":"0af53720-62c5-49e3-b396-aa1334e159c2","isBroken":false},"slices":[{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"paragraph","text":"We’re thrilled to announce that GSAP has added two more shiny accolades to its growing trophy shelf—a Gold Lovie Award and a People’s Choice Lovie Award in the Websites & Mobile Sites category! These wins are a testament to the bold innovation, creativity, and technical brilliance that GSAP represents, and we couldn’t be more chuffed to have worked with them on such an iconic project.","spans":[],"direction":"ltr"}]},"id":"news_content$807e16d1-8e3b-4706-82fd-3d10f893a552","slice_type":"news_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"quote":[{"type":"paragraph","text":"To stand out among such fierce competition is no small feat, and earning both a jury-selected Gold and the coveted People’s Choice speaks volumes about the impact of GSAP’s digital presence.","spans":[],"direction":"ltr"}]},"id":"news_quote$835976b3-e3d9-47c6-a823-8dd70bb75dff","slice_type":"news_quote","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"paragraph","text":"The Lovie Awards, Europe’s most prestigious celebration of internet excellence, received over 1,500 submissions from more than 30 countries this year, spotlighting the very best digital work across websites, apps, social content, and beyond. ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"This latest win adds to an already dazzling list of awards for GSAP, including 2 Webby Awards, multiple Awwwards, and CSS Design Awards, all culminating in driving greater downloads, revenue, and recognition within the design and development community. Our collaboration with GSAP helped redefine their public-facing identity, turning them into an undeniable force within the digital landscape and even paving the way for their acquisition by Webflow earlier this year.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We’re incredibly proud of what this partnership has achieved, and it’s heartening to see the hard work of both our teams recognised on such an esteemed stage.","spans":[],"direction":"ltr"}]},"id":"news_content$d9ba9054-0328-493d-b272-d77e3d975d03","slice_type":"news_content","slice_label":null}],"meta_description":"We’re thrilled to announce that GSAP has added two more shiny accolades to its growing trophy shelf—a Gold Lovie Award and a People’s Choice Lovie Award in the Websites & Mobile Sites category.","meta_image":{},"meta_title":"GSAP Wins Gold Lovie + People's Choice Award"}}],"version":"9eb0c14","license":"All Rights Reserved"}