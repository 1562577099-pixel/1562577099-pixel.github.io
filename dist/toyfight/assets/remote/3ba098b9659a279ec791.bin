{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"aRXpOBEAACcAPYZW","uid":"design-director","url":null,"type":"job_role","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aRXpOBEAACcAPYZW%22%29+%5D%5D","tags":[],"first_publication_date":"2025-11-13T14:28:23+0000","last_publication_date":"2025-11-13T15:05:23+0000","slugs":["the-role"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"job_title":"Design Director","job_tagline":"A Job Where Control Issues Are Considered a Skill","job_mini_description":[{"type":"paragraph","text":"We're looking for our next Design Director, is it you?","spans":[],"direction":"ltr"}],"tags":"Full Time, Remote","application_email":{"link_type":"Any"},"image":{},"introduction":[{"type":"paragraph","text":"Since 2015, we’ve partnered with everyone from global giants to startups with big-character energy. Crafting identities, design, digital experiences, and content for brands we believe in.","spans":[],"direction":"ltr"}],"slices":[{"variation":"default","version":"initial","items":[],"primary":{"heading":"Roles & Responsibilities","content":[{"type":"heading4","text":"The Role","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We’re looking for a Design Director who lives at the crossroads of strategy + craft + act-fast innovation. This person will steer our creative ship, mentor the crew, and push our studio and clients to do incredible work.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You’ll lead design vision across brand, digital, motion, and product, working directly with leadership, creative teams, and clients. You’ll set the bar high, question the status quo, and make great design feel inevitable.","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You'll Do","spans":[],"direction":"ltr"},{"type":"list-item","text":"Define and evolve our creative vision, ensuring it’s bold, original and aligned to ToyFight’s values.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Lead, mentor, and nurture our team of designers.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Oversee multi-disciplinary design projects end-to-end.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Ensure design work is not only beautiful but functional, on-brand, on-brief and on-time.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Stay ahead of trends, you’ll bring fresh thinking and ambition to the mix.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Maintain and develop the studio’s design standards.","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You’ll Bring","spans":[],"direction":"ltr"},{"type":"list-item","text":"We'd prefer around 5+ years of design experience in an agency.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Demonstrable excellence in design (and a portfolio to prove it).","spans":[],"direction":"ltr"},{"type":"list-item","text":"A strategic mindset.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Great taste and appreciation for design.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Fluent with design tools & processes.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Great communicator, you can speak design to designers, and with confidence and verve to clients.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A playful irreverence. (Yes. You’ll still be serious about design. But we appreciate a bit of playfulness now and then)","spans":[],"direction":"ltr"},{"type":"heading4","text":"Why Join Us","spans":[],"direction":"ltr"},{"type":"list-item","text":"You’ll lead a bright, agile studio doing meaningful work, not endless cookie-cutter campaigns.","spans":[],"direction":"ltr"},{"type":"list-item","text":"We invest in your training, conferences, and gear you need to make the good stuff.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A culture of candour, curiosity and boldness.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Competitive salary + benefits (we’ll talk specifics later).","spans":[],"direction":"ltr"}]},"id":"job_content$d41ccd7c-9b6e-4a96-a961-ecac734ea2bb","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Location","content":[{"type":"heading4","text":"Location","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Wherever you want.","spans":[],"direction":"ltr"}]},"id":"job_content$3e676e56-630f-432c-ba4e-4bc57d7f4893","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Salary","content":[{"type":"heading4","text":"Salary","spans":[],"direction":"ltr"},{"type":"paragraph","text":"£DOE","spans":[],"direction":"ltr"}]},"id":"job_content$5d6af2d9-7106-4028-afa3-ff8c410855cf","slice_type":"job_content","slice_label":null}],"meta_description":"Join ToyFight as our Design Director. Lead branding, digital design, and creative teams for global clients. Big ideas, bold thinking, zero templates. Apply now.","meta_image":{},"meta_title":"Lead Design at ToyFight | Design Director Position"}}],"version":"9eb0c14","license":"All Rights Reserved"}