{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"Zbd-lhIAAE8AOi3j","uid":"brave-bison","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Zbd-lhIAAE8AOi3j%22%29+%5D%5D","tags":[],"first_publication_date":"2024-01-29T10:32:14+0000","last_publication_date":"2024-05-21T12:18:27+0000","slugs":["brave-bison"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Brave Bison","popout_text":null,"strapline":"Raw Animal Magnetism","description":[{"type":"paragraph","text":"Brave Bison, a leading social and digital media company, needed a distinctive brand identity and website. We created a unique tone called \"Raw Animal Magnetism,\" crafting a bold branding that highlights their creativity and ability to attract top clients and talent.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Using a powerful visual language and immersive web experience, we showcased Brave Bison's innovative approach, combining social media marketing and content creation with a media network reaching millions. Our design captured the energy and forward-thinking spirit that distinguishes Brave Bison in the digital media landscape.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":212,"height":120},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/ZjzFKkMTzAJOCqX3_bb-thumb.jpg?auto=format,compress","id":"ZjzFKkMTzAJOCqX3","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":"https://res.cloudinary.com/durdzswls/video/upload/f_auto:video,q_auto/v1/case-studies/brave-bison/bb-work-thumb","thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":212,"thumbnail_video_height":120,"background_color":"#1C1C1E","hero_image":{},"hero_video_url":"case-studies/brave-bison/bb-hero","hero_image_inset_colou