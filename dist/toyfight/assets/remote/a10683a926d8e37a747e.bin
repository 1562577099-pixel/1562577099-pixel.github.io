{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"Zbt0fxAAAEQjYA_-","uid":"sound-stage","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Zbt0fxAAAEQjYA_-%22%29+%5D%5D","tags":[],"first_publication_date":"2024-02-01T10:37:55+0000","last_publication_date":"2024-05-14T12:44:53+0000","slugs":[],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Sound/Stage","popout_text":null,"strapline":"The Show Must Go On","description":[{"type":"paragraph","text":"As the pandemic hit, LA Philharmonic realised they needed to find another way to reach their audience. They approached us with an idea for a series of streamed concerts so fans could enjoy them from the comfort of their own homes.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We designed and developed a platform which delivered a new streaming episode each week and also featured bonus content including essays and playlists.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":160,"height":212},"alt":"Sound/Stage LA Philharmonic","copyright":null,"url":"https://images.prismic.io/toyfight/ZjyouEMTzAJOCqQH_ss-thumb.png?auto=format,compress","id":"ZjyouEMTzAJOCqQH","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":null,"thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":null,"thumbnail_video_height":null,"background_color":"#CDCCC7","hero_image":{"dimensions":{"width":2968,"height":2128},"alt":"Sound Stage","copyright":null,"url":"https://images.prismic.io/toyfight/65bb724e615e73009ec42ea2_SoundStage-1.jpg?auto=format,compress","id":"ZbtyTmFecwCexC6i","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"hero_video_url":null,"hero_image_inset_colour":null,"live_site_url":{"link_type":"Web","key":"a8e6dc26-ac35-4669-a8e1-f