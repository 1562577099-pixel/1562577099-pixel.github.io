{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"ZiktlBIAAHjFcJeZ","uid":"gsap-wins-2-webbys","url":null,"type":"news","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZiktlBIAAHjFcJeZ%22%29+%5D%5D","tags":[],"first_publication_date":"2024-04-24T16:09:47+0000","last_publication_date":"2024-05-13T12:17:37+0000","slugs":[],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"ToyFight x GSAP = 2 Webby Awards!","heading_colours":[{"word_index":0,"word_colour":"#FFF490"},{"word_index":2,"word_colour":"#E9E3F3"}],"banner_image":{"dimensions":{"width":2592,"height":1600},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/Zj3VaUFLKBtrWxWP_03Hero.jpg?auto=format,compress","id":"Zj3VaUFLKBtrWxWP","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"banner_video_url":"case-studies/gsap/ww-banner","date_string":"April 2024","thumbnail":{},"thumbnail_video":null,"related_news":{"id":"Zfl_KxIAAPSMwt63","type":"news","tags":[],"lang":"en-gb","slug":"-","first_publication_date":"2024-03-19T12:06:09+0000","last_publication_date":"2024-05-13T12:18:52+0000","uid":"building-gsap-asap","link_type":"Document","key":"684a4c91-5448-41da-9e65-0348740e050f","isBroken":false},"slices":[{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"paragraph","text":"The new GSAP website has been named the winner in both the \"Web Services & Applications\" and \"Best Use of Animation or Motion Graphics\" categories at the 2024 Webbys!","spans":[],"direction":"ltr"},{"type":"paragraph","text":"GSAP had already swept up an Awwwards Site of the Day and been nominated for Site of the Month, with one of our highest ever \"Dev Scores\" (8.49), so we had high hopes when we saw the Webby nominations.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"That said, the \"Web Services & Applications\" category was particularly competitive, with the site facing up against big hitters like Google, Spotify and GIPHY.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Nevertheless, GSAP was named the winner of both categories, joining Apple, Rihanna, and Former President Barack Obama on the list of 2024 Webby winners, and we couldn't be prouder!","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We look forward to Barack (first name terms) giving us a shout out on his blog.","spans":[{"start":70,"end":73,"type":"em"}],"direction":"ltr"}]},"id":"news_content$807e16d1-8e3b-4706-82fd-3d10f893a552","slice_type":"news_content","slice_label":null}],"meta_description":"The new GSAP website has been named the winner in both the \"Web Services & Applications\" and \"Best Use of Animation or Motion Graphics\" categories at the 2024 Webbys!","meta_image":{},"meta_title":"ToyFight x GSAP = Awards"}}],"version":"9eb0c14","license":"All Rights Reserved"}