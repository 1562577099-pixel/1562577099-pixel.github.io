{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"Z1gp6RIAACEAVSqv","uid":"fresh-faces-2024","url":null,"type":"news","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Z1gp6RIAACEAVSqv%22%29+%5D%5D","tags":[],"first_publication_date":"2024-12-10T11:51:15+0000","last_publication_date":"2024-12-10T12:08:20+0000","slugs":["fresh-faces-join-toyfight"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Fresh Faces Join ToyFight","heading_colours":[{"word_index":0,"word_colour":"#FFC7E3"},{"word_index":2,"word_colour":"#FFF857"}],"banner_image":{"dimensions":{"width":2592,"height":1600},"alt":"Fresh Faces at ToyFight","copyright":null,"url":"https://images.prismic.io/toyfight/Z1gu3ZbqstJ98QdZ_team-shot-alt-2.jpg?auto=format,compress","id":"Z1gu3ZbqstJ98QdZ","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"banner_video_url":null,"date_string":"November 2024","thumbnail":{},"thumbnail_video":null,"related_news":{"id":"Z1gmmhIAACIAVSXo","type":"news","tags":[],"lang":"en-gb","slug":"gsap-wins-gold-lovie--peoples-choice-award","first_publication_date":"2024-12-10T11:36:10+0000","last_publication_date":"2024-12-10T12:08:58+0000","uid":"gsap-lovie-wins","link_type":"Document","key":"0e46362f-aec4-488b-863b-6d5745654fc2","isBroken":false},"slices":[{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"paragraph","text":"We’re levelling up! ToyFight is delighted to welcome three stellar new hires to our design team as Interactive Designers. With fresh talent from leading agencies and a passion for creating unforgettable digital experiences, James, Pavle, and Boris are here to help us take on 2025 with bold ideas and boundless creativity.","spans":[],"direction":"ltr"}]},"id":"news_content$807e16d1-8e3b-4706-82fd-3d10f893a552","slice_type":"news_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"quote":[{"type":"paragraph","text":"As we gear up for another year of bold, innovative work, we’re confident that this talented trio will play a key role in helping us continue to push boundaries and create standout digital experiences. Watch this space—we can’t wait to share what’s next.","spans":[],"direction":"ltr"}]},"id":"news_quote$835976b3-e3d9-47c6-a823-8dd70bb75dff","slice_type":"news_quote","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"paragraph","text":"James Hartwell joins us from the Bureau for Visual Affairs, where he honed his craft designing for screen and brand. With a sharp eye for detail and a knack for creating intuitive, engaging digital experiences, James is set to add a new layer of creative flair to the ToyFight team.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Pavle Jonic comes to us from Holographik, bringing with him a wealth of experience in crafting interactive designs that captivate and inspire. Boris Spasojevic, also joining us from Holographik, rounds out our trio of new hires. With a deep passion for pushing the boundaries of digital design, Boris thrives on delivering work that’s as visually stunning as it is user-friendly.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Since joining, James, Pavle, and Boris have hit the ground running, contributing to projects for some of our incredible clients, including PayPal, Meta, RICOH, and Royal Caribbean Cruises. Their skills have already brought fresh depth and quality to the studio’s creative output, and we’re excited to see how they’ll continue to elevate our work.","spans":[],"direction":"ltr"}]},"id":"news_content$d9ba9054-0328-493d-b272-d77e3d975d03","slice_type":"news_content","slice_label":null}],"meta_description":"ToyFight is delighted to welcome three stellar new hires to our design team as Interactive Designers. With fresh talent from leading agencies and a passion for creating unforgettable digital experiences, James, Pavle, and Boris are here to help us take on 2025 with bold ideas and boundless creativity.","meta_image":{},"meta_title":"Fresh Faces Join ToyFight"}}],"version":"9eb0c14","license":"All Rights Reserved"}