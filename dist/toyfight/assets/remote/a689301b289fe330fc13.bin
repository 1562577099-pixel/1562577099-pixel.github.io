{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"aRNabxAAACoAdxwq","uid":"soda","url":null,"type":"news","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aRNabxAAACoAdxwq%22%29+%5D%5D","tags":[],"first_publication_date":"2025-11-11T16:01:12+0000","last_publication_date":"2025-11-17T19:10:06+0000","slugs":["whoop.-were-officially-in."],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"ToyFight Joins SoDA. Presumably on Purpose.","heading_colours":[{"word_index":3,"word_colour":"#FFF490"},{"word_index":1,"word_colour":"#E9E3F3"}],"banner_image":{"dimensions":{"width":2592,"height":1600},"alt":null,"copyright":null,"url":"https://images.prismic.io/toyfight/aRNdqbpReVYa4WOr_ArticleImageSoDA.jpg?auto=format,compress","id":"aRNdqbpReVYa4WOr","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"banner_video_url":null,"date_string":"November, 2025","thumbnail":{},"thumbnail_video":null,"related_news":{"id":"aRNMOhAAACkAdwgI","type":"news","tags":[],"lang":"en-gb","slug":"awards-mentions--momentum","first_publication_date":"2025-11-11T14:55:56+0000","last_publication_date":"2026-01-28T10:58:12+0000","uid":"gold-run","link_type":"Document","key":"52a9d6b1-f131-40b0-85fc-3869c630d69e","isBroken":false},"slices":[{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"heading4","text":"Whoop. We’re officially in.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"ToyFight has joined SoDA (the Society of Digital Agencies) and we couldn’t be happier to be rubbing shoulders with some of the best brains in the business (so f*** you LinkedIn).","spans":[{"start":20,"end":24,"type":"hyperlink","data":{"link_type":"Web","url":"https://www.sodaspeaks.com/about","target":"_blank"}}],"direction":"ltr"}]},"id":"news_content$807e16d1-8e3b-4706-82fd-3d10f893a552","slice_type":"news_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"heading4","text":"Why SoDA?","spans":[],"direction":"ltr"},{"type":"paragraph","text":"It’s where the world’s most forward‑thinking agencies swap ideas, make great work, and keep raising the bar ... and somehow, us.","spans":[{"start":15,"end":53,"type":"hyperlink","data":{"link_type":"Web","url":"https://www.sodaspeaks.com/members","target":"_blank"}}],"direction":"ltr"}]},"id":"news_content$1b6a2317-120b-4926-a49a-83d1d67cf918","slice_type":"news_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"heading4","text":"What This Means","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We get access to conversations that go beyond the usual agency small talk. Real talk about creative leadership, operational excellence, AI, innovation, and all the juicy bits in between.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"It also means more opportunities to:","spans":[],"direction":"ltr"},{"type":"paragraph","text":"– Collaborate with like-minded studios","spans":[],"direction":"ltr"},{"type":"paragraph","text":"– Share what we’ve learned (and what we’ve messed up)","spans":[],"direction":"ltr"},{"type":"paragraph","text":"– Champion better, smarter, more original creative work","spans":[],"direction":"ltr"}]},"id":"news_content$a2f2eb58-36df-4104-a887-03db8c0e88d3","slice_type":"news_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"content":[{"type":"heading4","text":"Not really our thing","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We’ve never been the “joiner” type. But SoDA isn’t another badge, it’s a community of businesses that help each other. And we’re excited to show up, speak up, and help build something that lasts.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"So here’s to new faces, new perspectives, and hopefully a few new mates along the way.","spans":[],"direction":"ltr"}]},"id":"news_content$e19da65f-ff46-4083-8075-33a9c4b4ea1b","slice_type":"news_content","slice_label":null}],"meta_description":"We’re proud to join SoDA—home to the world’s top digital agencies. It’s a smart, inspiring community… and us. We’re here to learn, share with others.","meta_image":{},"meta_title":"oyFight Joins SoDA | Somehow, They Let Us In"}}],"version":"9eb0c14","license":"All Rights Reserved"}