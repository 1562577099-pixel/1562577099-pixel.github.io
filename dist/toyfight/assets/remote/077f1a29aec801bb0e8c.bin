{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"aRNBOBAAACcAdvfI","uid":"ink","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aRNBOBAAACcAdvfI%22%29+%5D%5D","tags":[],"first_publication_date":"2025-11-11T14:19:21+0000","last_publication_date":"2025-11-11T14:35:19+0000","slugs":["ink-games"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Ink Games","popout_text":null,"strapline":"A New Era of Gaming","description":[{"type":"paragraph","text":"INK Games is a next-gen gaming platform that blends real-world rewards with immersive digital experiences.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Our challenge was to craft a site that matched the ambition of their platform—interactive, fluid, and future-facing—without compromising performance.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We designed and developed a high-impact, animation-rich experience using a shared 3D canvas system powered by React Three Fiber and GSAP. Custom “portal cards” blend DOM and WebGL layers, creating dynamic, perspective-driven content blocks that respond to scroll and cursor movement. The end result is a seamless digital experience that feels as alive as the games themselves.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":212,"height":120},"alt":"Ink Games Website","copyright":null,"url":"https://images.prismic.io/toyfight/aRNBzbpReVYa4Vqg_wide-thumb.jpg?auto=format,compress","id":"aRNBzbpReVYa4Vqg","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":null,"thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":212,"thumbnail_video_height":120,"background_color":"#212826","hero_image":{"dimensions":{"width":2968,"height":2128},"alt":"Ink Games Website","copyright":null,