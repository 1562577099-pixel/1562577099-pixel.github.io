{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"Z1ldYBIAACAAVt3W","uid":"motion-designer","url":null,"type":"job_role","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22Z1ldYBIAACAAVt3W%22%29+%5D%5D","tags":[],"first_publication_date":"2024-12-11T09:44:21+0000","last_publication_date":"2026-03-17T16:33:44+0000","slugs":["the-role"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"job_title":"Motion Designer","job_tagline":"Keyframe Kings and Queens","job_mini_description":[],"tags":"Full Time, Remote","application_email":{"link_type":"Any"},"image":{},"introduction":[{"type":"paragraph","text":"Come join the team at ToyFight. We're a team of strategists, designers, developers and technologists with a passion for creating digital experiences for consumers and brands.","spans":[],"direction":"ltr"}],"slices":[{"variation":"default","version":"initial","items":[],"primary":{"heading":"Roles & Responsibilities","content":[{"type":"heading4","text":"The Role","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You are a passionate motion designer who thrives on creating dynamic, engaging experiences across digital platforms.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"With your creative flair, you’ll collaborate on a variety of projects and briefs alongside the design and development teams, focusing on 2D interface, digital product prototypes, proof of concepts and brand motion design—plus, any skills in 3D animation and motion are a welcomed bonus.  ","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You will have a strong creative point of view but know how to collaborate, take feedback constructively, and discern when to push back and when to listen.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"You excel in team environments and can manage your own workload effectively to meet deadlines while delivering work that exceeds expectations.","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You'll Do","spans":[],"direction":"ltr"},{"type":"list-item","text":"Create motion designs that elevate interfaces, brands, and digital experiences.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Collaborate with teams to bring ideas to life through motion and prototyping.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Apply attention to detail and care for design to make a meaningful impact.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Work with diverse clients—from startups to global brands—on a wide variety of projects.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Bring concepts to life, clearly articulating your vision through strategic thinking, motion, and visual storytelling.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"},{"type":"heading4","text":"What You’ll Bring","spans":[],"direction":"ltr"},{"type":"list-item","text":"3+ years of motion design experience.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Ability to understand briefs, strategy and offer effective solutions to complex problems.","spans":[],"direction":"ltr"},{"type":"list-item","text":"A love for all aspects of design and animation, including conceptual thinking.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Strong understanding of motion tools such as, After Effects, Jitter and other editors.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Able to present work through excellent communication skills, both written and verbal.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Ability to create storyboards.","spans":[],"direction":"ltr"},{"type":"list-item","text":"Bonus points for skills in illustration, and 3D.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Use the 'Apply Now' button, or email careers@toyfight.co with the subject 'Motion Designer Role'.","spans":[],"direction":"ltr"}]},"id":"job_content$d41ccd7c-9b6e-4a96-a961-ecac734ea2bb","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Location","content":[{"type":"heading4","text":"Location","spans":[],"direction":"ltr"},{"type":"paragraph","text":"Wherever you want.","spans":[],"direction":"ltr"}]},"id":"job_content$3e676e56-630f-432c-ba4e-4bc57d7f4893","slice_type":"job_content","slice_label":null},{"variation":"default","version":"initial","items":[],"primary":{"heading":"Salary","content":[{"type":"heading4","text":"Salary","spans":[],"direction":"ltr"},{"type":"paragraph","text":"£DOE","spans":[],"direction":"ltr"}]},"id":"job_content$5d6af2d9-7106-4028-afa3-ff8c410855cf","slice_type":"job_content","slice_label":null}],"meta_description":"Motion Designer - Come join the team at ToyFight. We're a team of strategists, designers, developers and technologists with a passion for creating digital experiences for consumers and brands.","meta_image":{},"meta_title":"Motion Designer Role at ToyFight"}}],"version":"9eb0c14","license":"All Rights Reserved"}