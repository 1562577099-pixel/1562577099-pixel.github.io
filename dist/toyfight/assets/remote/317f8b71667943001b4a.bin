{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"ZjJWQhEAAIMXVnQV","uid":"kfc","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZjJWQhEAAIMXVnQV%22%29+%5D%5D","tags":[],"first_publication_date":"2024-05-01T14:54:24+0000","last_publication_date":"2024-05-09T06:53:08+0000","slugs":[],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"KFC App","popout_text":null,"strapline":"Delicious Chicken","description":[{"type":"paragraph","text":"We worked closely with BASIC agency to reimagine the new KFC app experience. Our team contributed strategy, visual design, and motion, ensuring every detail resonated with the brand. We helped guide the team by providing insights into consumer behavior and aligning the design with KFC's values, ensuring the final product reflected the warmth and personality of the Colonel.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"","spans":[],"direction":"ltr"},{"type":"paragraph","text":"We shaped the design and user experience, crafting an intuitive app that offers swift, convenient ordering while capturing the Colonel's distinctive, irreverent voice. By incorporating strong motion design and embracing KFC's playful tone, we transformed the typical sterile quick-service app into an irresistible experience.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":160,"height":212},"alt":"KFC App","copyright":null,"url":"https://images.prismic.io/toyfight/ZjxyckMTzAJOCpfN_kfc-thumb.png?auto=format,compress","id":"ZjxyckMTzAJOCpfN","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":null,"thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":null,"thumbnail_video_height":null,"background_color":null,"hero_image":{"dimensions":{"width":2968,"height":2128},"al