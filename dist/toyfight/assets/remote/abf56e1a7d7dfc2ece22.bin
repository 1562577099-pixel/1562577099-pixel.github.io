{"page":1,"results_per_page":20,"results_size":1,"total_results_size":1,"total_pages":1,"next_page":null,"prev_page":null,"results":[{"id":"aSYgTREAACUAVIBr","uid":"cgapp","url":null,"type":"case_study","href":"https://toyfight.cdn.prismic.io/api/v2/documents/search?ref=ar0VLREAACcAMgk6&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aSYgTREAACUAVIBr%22%29+%5D%5D","tags":[],"first_publication_date":"2025-11-25T21:50:26+0000","last_publication_date":"2025-11-27T09:07:35+0000","slugs":["cult-gaia-app"],"linked_documents":[],"lang":"en-gb","alternate_languages":[],"data":{"title":"Cult Gaia App","popout_text":"The Art of Designing","strapline":"Sculptural Style Gets an App","description":[{"type":"paragraph","text":"Cult Gaia has long been one of our favourite brands. After the success of their website redesign, the team came back to us to help shape the next chapter of their digital journey.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"This time, we were tasked with designing a mobile app. The goal was to create an experience that lives closer to the customer, offering a more personal and immersive interaction with the brand. The result is a tactile, emotionally driven interface that reflects the sculptural elegance of Cult Gaia’s aesthetic and turns everyday browsing into something elevated.","spans":[],"direction":"ltr"},{"type":"paragraph","text":"From pixel to platform, every detail was carefully crafted to echo the artistry of their collections and transform utility into aspiration.","spans":[],"direction":"ltr"}],"thumbnail":{"dimensions":{"width":160,"height":212},"alt":"CG App","copyright":null,"url":"https://images.prismic.io/toyfight/aSYkO2GnmrmGqTtE_thumb.png?auto=format,compress","id":"aSYkO2GnmrmGqTtE","edit":{"x":0,"y":0,"zoom":1,"background":"transparent"}},"thumbnail_video_url":null,"thumbnail_video_actual_file":{"link_type":"Media"},"thumbnail_video_width":212,"thumbnail_video_height":120,"background_color":null,"hero_image":{"dimensions":{"widt